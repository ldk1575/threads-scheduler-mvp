# 복사해서 .env 로 쓰세요. .env 는 커밋되지 않습니다.

# ── Threads ───────────────────────────────────────────
# 개발자 콘솔에서 발급. 장기 토큰은 60일이며 발급 24시간 뒤부터 갱신 가능합니다.
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# 필요한 스코프 (발행만 할 경우 앞의 둘)
# threads_basic, threads_content_publish, threads_read_replies, threads_manage_replies

# ── LLM ───────────────────────────────────────────────
# CLI 모드는 로컬 개발용입니다. 배포 환경에서는 API 모드를 쓰십시오.
#   gemini-cli | codex-cli | claude-cli | gemini-api | openai-api
LLM_PRIMARY=gemini-api
LLM_SECONDARY=openai-api

# API 모드를 쓸 때만 필요합니다
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── 저장소 (다음 단계) ────────────────────────────────
# 영속 저장소 연결 문자열 (다음 단계). 현재 MVP 는 인메모리로 동작합니다.
DATABASE_URL=

# ── 발행 정책 ─────────────────────────────────────────
