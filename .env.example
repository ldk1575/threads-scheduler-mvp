# 복사해서 .env 로 쓰세요. .env 는 커밋되지 않습니다.

# ── Threads ───────────────────────────────────────────
# 개발자 콘솔에서 발급. 장기 토큰은 60일이며 발급 24시간 뒤부터 갱신 가능합니다.
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# 필요한 스코프 (발행만 할 경우 앞의 둘)
# threads_basic, threads_content_publish, threads_read_replies, threads_manage_replies

# ── LLM ───────────────────────────────────────────────
# CLI 모드는 로컬 개발용입니다. 배포 환경에서는 API 모드를 쓰십시오.
#   gemini-cli | codex-cli | claude-cli | gemini-api | openai-api
LLM_PRIMARY=gemini-api
LLM_SECONDARY=openai-api

# API 모드를 쓸 때만 필요합니다
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── Supabase (선택) ───────────────────────────────────
# 비워 두면 인메모리 저장소로 동작합니다. npm test 는 그대로 통과합니다.
# 채우면 npm run test:supabase 가 실제 DB 에 붙어 같은 계약을 검증합니다.
#
# 대시보드 → Project Settings → API 에서 가져옵니다.
SUPABASE_URL=

# ⚠️ service_role 키입니다. RLS 를 우회하므로 **서버에서만** 씁니다.
#    브라우저로 내려보내면 DB 전체가 열립니다. 절대 커밋하지 마세요.
SUPABASE_SERVICE_KEY=

# ── 발행 정책 ─────────────────────────────────────────

# ── Threads (실계정 발행용) ───────────────────────────
# 개발자 콘솔에서 발급한 장기 토큰. 60일 만료입니다.
THREADS_ACCESS_TOKEN=

# 비워 두면 `me` 를 씁니다. 필요할 때만 채우세요.
THREADS_USER_ID=

# ── 글쓰기 페르소나 (선택) ────────────────────────────
PERSONA_AUDIENCE=
PERSONA_TONE=
PERSONA_EXPERIENCE=

# 글에 넣을 추적 링크. 비우면 링크 없이 씁니다.
TRACKING_LINK=

# Anthropic API (배포 환경용). CLI 는 이 컴퓨터에서만 됩니다.
ANTHROPIC_API_KEY=
